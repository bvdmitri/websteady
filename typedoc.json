{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["packages/websteady/src/index.ts"],
  "tsconfig": "packages/websteady/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "out": "docs/api",
  "docsRoot": "docs",
  "name": "@bvdmitri/websteady",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "excludeExternals": true,
  "gitRevision": "main",
  "gitRemote": "origin"
}
